{
    "name": "mitisk/yii2-lightweight-waf",
    "description": "Lightweight WAF for Yii2 to protect against vulnerability scanners natively before framework initialization.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Mitisk\\Waf\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Mitisk\\Waf\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
